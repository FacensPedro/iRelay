{
  "name": "irelay",
  "productName": "iRelay",
  "version": "2.3.0",
  "description": "Install Steam, GOG and Epic games on a Windows PC and copy them to iDeck over USB.",
  "main": "shell/main.js",
  "author": "FacensPedro",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "@electron/asar": "3.2.17",
    "@electron/packager": "18.3.6",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.facenspedro.irelay",
    "productName": "iRelay",
    "copyright": "Copyright \u00a9 FacensPedro",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "shell/**",
      "app/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "iRelay.exe",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "iRelay"
    },
    "portable": {
      "unicode": true,
      "requestExecutionLevel": "user"
    }
  }
}
