{
  "name": "irelay",
  "productName": "iRelay",
  "version": "3.2.0",
  "description": "Install Steam, GOG and Epic games on a Windows PC and copy them to iDeck over USB.",
  "main": "shell/main.js",
  "author": "FacensPedro",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "@electron/asar": "3.2.17",
    "@electron/packager": "18.3.6",
    "electron": "42.11.13",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.facenspedro.irelay",
    "productName": "iRelay",
    "copyright": "Copyright \u00a9 FacensPedro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "shell/**",
      "app/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "iRelay-Setup.exe",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "iRelay"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "iRelay",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "iRelay-Setup.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
